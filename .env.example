# Configuração local do DOTE. Preencha somente este arquivo na raiz.
# Copie .env.example para .env. Valores reais ficam no .env ignorado pelo Git.

# API e sessão
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/dote_dev
# Gere com node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Vazio usa localhost:5173 no Vite e localhost:8080 no Compose.
# Para outro endereço, preencha a origem pública completa.
FRONTEND_URL=

# Gemini opcional. Preencha a chave para habilitar IA.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash

# E-mail opcional. Preencha os dados do seu provedor SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DOTE <no-reply@dote.dev>"

# Frontend. Vazio usa o proxy local. No deploy, use a origem da API sem /api.
# VITE_* é público no navegador.
VITE_API_URL=

# Docker Compose local
APP_BIND=127.0.0.1
APP_PORT=8080
MONGO_PORT=27018
